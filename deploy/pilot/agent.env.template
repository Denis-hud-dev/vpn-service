# Review-only pilot template. Populate secrets only in /etc/kudavpn-pilot/agent.env (0600).
NODE_AGENT_STATE=/var/lib/kudavpn-pilot/leases.db
NODE_AGENT_MAX_USERS=1
NODE_AGENT_LISTEN=127.0.0.1
NODE_AGENT_PORT=19443
NODE_AGENT_CERT=/etc/kudavpn-pilot/agent.crt
NODE_AGENT_KEY=/etc/kudavpn-pilot/agent.key
NODE_AGENT_CLIENT_CA=/etc/kudavpn-pilot/client-ca.crt
XRAY_BINARY=/opt/kudavpn-pilot/bin/xray
XRAY_CONFIG=/etc/kudavpn-pilot/xray-9443.json
XRAY_API_ADDRESS=127.0.0.1:19085
XRAY_INBOUND_TAG=kuda-pilot-9443
XRAY_INBOUND_PORT=9443
XRAY_RESERVED_PORTS=443,8443
