# Support-only credentials. Set real values ONLY in a private server file, mode 0600.
SUPPORT_BOT_TOKEN=
SUPPORT_BOT_USERNAME=
SUPPORT_ADMIN_CHAT_ID=
SUPPORT_OPERATOR_IDS=
SUPPORT_DB_PATH=/var/lib/kudavpn-support/support.sqlite3
# Enable only after this dedicated bot can use existing button custom emoji.
SUPPORT_CUSTOM_EMOJI=0
# Closed testing only: set the verified owner's ID, add other testers explicitly.
# Empty means public user access; do NOT leave empty for the first closed test.
SUPPORT_TEST_USER_IDS=SET_VERIFIED_OWNER_ID
