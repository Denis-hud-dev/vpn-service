# Telegram: real token only in local .env
BOT_TOKEN=
SUPPORT_USERNAME=

# PostgreSQL: fill passwords locally; URLs use URL-encoded password
POSTGRES_DB=kudavpn
POSTGRES_USER=kudavpn
POSTGRES_PASSWORD=
# Local host: postgresql+psycopg://USER:ENCODED_PASSWORD@127.0.0.1:5432/DB
DATABASE_URL=
# Compose host: postgresql+psycopg://USER:ENCODED_PASSWORD@postgres:5432/DB
DATABASE_URL_DOCKER=

# Future YooKassa integration: optional and unused in stage 2
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=

# Optional future Happ delivery in bot; set both only after HTTPS feed and nodes are ready.
# Generate a 32-byte random key locally, base64url without padding. Never commit its value.
SUBSCRIPTION_PUBLIC_URL=
HAPP_LINK_SECRET=
